{
  "name": "tv-tracker-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.docs.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "package": "npm run build && node scripts/package-extension.js"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.2.0",
    "@types/node": "^26.0.1",
    "archiver": "^8.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^27.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.2",
    "vitest": "^3.2.6"
  }
}
