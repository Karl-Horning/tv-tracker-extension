{
  "manifest_version": 3,
  "name": "TV Tracker",
  "version": "0.1.0",
  "description": "Track when your favourite TV shows last aired and when they're on next.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}